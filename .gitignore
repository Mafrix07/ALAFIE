# ==============================================================================
# .gitignore - Projet Alafiè (Flutter Mobile + Back-office Node.js)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sécurité & Fichiers d'environnement (Crucial pour la conformité et la sécurité)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.keystore
*.jks
*.p12

# ------------------------------------------------------------------------------
# 2. Bases de données locales & fichiers temporaires
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
dump.sql
*.sql.gz

# ------------------------------------------------------------------------------
# 3. Flutter & Dart (Application Mobile)
# ------------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/

# Android spécifique (Flutter)
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/**/*.apk
**/android/**/*.aab

# iOS spécifique (Flutter)
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Generated.xcconfig
**/ios/Runner/GeneratedPluginRegistrant.h
**/ios/Runner/GeneratedPluginRegistrant.m

# ------------------------------------------------------------------------------
# 4. Node.js (Back-office & scripts d'importation)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ------------------------------------------------------------------------------
# 5. Éditeurs & IDEs (VS Code, Android Studio, IntelliJ)
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr

# ------------------------------------------------------------------------------
# 6. Fichiers système (Windows, macOS, Linux)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
[Dd]esktop.ini
